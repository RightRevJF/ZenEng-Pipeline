 "how the builds were read": "\"\"\"One song's builds read by the engine's own window, measures and candidates (songs/p54, read only). Usage: python3 engine_rows.py SONG PART\"\"\"\nimport sys, os, json, pickle, importlib, io, contextlib, numpy as np, pandas as pd\ns, part = sys.argv[1], sys.argv[2]; os.environ[\"ZE_PART\"] = part; sys.argv = [\"x\", \"1\", \"main\"]; sys.path[:0] = [\"/home/claude/p54\", \"/home/claude/p40\"]\nwith contextlib.redirect_stdout(io.StringIO()): P = importlib.import_module(f\"melody_v128_p{s}\")\nD = pickle.load(open(f\"/home/claude/p54/melody_v128_p{s}_main.pkl\", \"rb\")); rows = []\nfor bi, c in enumerate(D[\"every\"]):\n    if c.get(\"partial\"): continue\n    ns = [dict(on=o, dur=d, p=p, sec=x, line=l) for o, d, p, x, l, st, sy in c[\"notes\"]]\n    for sec in (\"Verse 1\", \"Chorus 1\", \"Verse 2\", \"Bridge\"):\n        if sec not in P.BAR0: continue\n        N = P.win_N(ns, P.BAR0[sec]); f = P.feats(N, P.mton())\n        if not f: continue\n        r = dict(f); r.update(P.cand(sorted(N)) or {}); r.update(song=s, build=bi, fp=c[\"fp\"], sec=sec, alive=c[\"cause\"] is None, clean=(c[\"cause\"] is None and not c[\"soft\"]), engine_refit=P.refit_score(f, N), n_notes=len(N))\n        rows.append(r)\npd.DataFrame(rows).to_pickle(f\"/home/claude/zeneng/corpus/run3/engine_rows_{s}.pkl\"); print(s, len(rows), D[\"survivors\"], D.get(\"order_fp\"))\n"
}