 "code": "\"\"\"Windows 141-143 read again on the v119 port's builds, beside v118's. Predictions in PREDICTION.md. Run: python3 reread.py\"\"\"\nimport json, sys, pickle, collections, warnings, numpy as np, pandas as pd\nwarnings.filterwarnings(\"ignore\")\nfrom sklearn.pipeline import make_pipeline; from sklearn.impute import SimpleImputer; from sklearn.preprocessing import StandardScaler; from sklearn.linear_model import LogisticRegression; from sklearn.metrics import roc_auc_score\nW = \"/home/claude/zeneng/corpus/whole/\"; B = \"/home/claude/zeneng/corpus/bass/\"\nsrc = open(W + \"whole_study.py\").read().split(\"rows = []; wins = {}\")[0]; exec(src)                 # om, pair, cand ...\nsys.path.insert(0, B); import bass_study as BS\nKA = pd.read_pickle(W + \"whole_windows.pkl\"); KO = pd.read_pickle(B + \"outer_windows.pkl\"); FO = json.load(open(W + \"whole_findings.json\")); AG = FO[\"measures the two collections agree on\"]; FE = AG + HARM\nimport re\nbbt = {re.sub(r\"[^a-z]\", \"\", s.split(\"_\")[1].lower()) for s in set(KA[KA.body == \"bb\"].piece)}\nKA = KA[(KA.body == \"bb\") | ((KA.body == \"rs\") & (KA.year >= 1958) & (KA.year <= 1991) & ~KA.piece.map(lambda s: \"_\" in s and re.sub(r\"[^a-z]\", \"\", s.split(\"_\")[1].lower()) in bbt))]; KO = KO[KO.body != \"build\"]\nNAME = {\"C\": 0, \"D\": 2, \"E\": 4, \"F\": 5, \"G\": 7, \"A\": 9, \"B\": 11}\ndef pcs(c):\n    c = c.split(\"/\")[0]; r = NAME[c[0]] + (1 if \"#\" in c[:2] else -1 if (len(c) > 1 and c[1] == \"b\") else 0); m = \"m\" in c[1:3] and \"maj\" not in c; return frozenset({r % 12, (r + (3 if m else 4)) % 12, (r + 7) % 12})\ndef eng(c):\n    c = c.split(\"/\")[0]; r = NAME[c[0]] + (1 if \"#\" in c[:2] else -1 if (len(c) > 1 and c[1] == \"b\") else 0); m = \"m\" in c[1:3] and \"maj\" not in c; return (r % 12, frozenset((0, 3 if m else 4, 7)), 0, False)\nSECS = {\"Verse 1\": (\"verse\", \"1\"), \"Verse 2\": (\"verse\", \"2\"), \"Chorus 1\": (\"chorus\", \"1\"), \"Bridge\": (\"bridge\", \"1\")}; TON = {\"40\": 2, \"42\": 10, \"43\": 0, \"44\": 3, \"45\": 7}\nrows, orow, wins = [], [], {}\nfor ver, path in ((\"v118\", \"/home/claude/p50/melody_v118_p%s_main.pkl\"), (\"v119\", \"/home/claude/p51/melody_v119_p%s_main.pkl\")):\n    for s, ton in TON.items():\n        P = pickle.load(open(path % s, \"rb\")); st = {}; i = 0\n        for name, kind, nb in P[\"form\"]: st[name] = (i, nb); i += nb\n        for bi, c in enumerate([c for c in P[\"every\"] if not c.get(\"partial\")][:400]):\n            for name, (sec, k) in SECS.items():\n                if name not in st or st[name][1] < 8: continue\n                b0 = st[name][0]; raw = sorted(((t[0] - b0 * 48) / 12, t[2], P[\"chords\"][t[0] // 48]) for t in c[\"notes\"] if b0 * 48 <= t[0] < (b0 + 8) * 48 and t[3] == name)\n                m = om([(t, p, pcs(ch)) for t, p, ch in raw], ton, False)\n                if m: rows.append(dict(m, ver=ver, song=s, build=bi, sec=sec, k=k)); wins[(ver, s, bi, sec, k)] = [(t, p) for t, p, ch in raw]\n                if k == \"1\" and sec in (\"verse\", \"chorus\"):\n                    o = BS.outer([(t, p, eng(ch)) for t, p, ch in raw])\n                    if o: orow.append(dict(o[0], ver=ver, song=s, build=bi, sec=sec))\nA = pd.DataFrame(rows); O = pd.DataFrame(orow); A.to_pickle(\"reread_windows.pkl\"); O.to_pickle(\"reread_outer.pkl\")\nS = lambda D, s, k: D[(D.sec == s) & (D.k == k)]; SG = list(TON); out = {\"builds read (each version, song)\": 400}\ndef row(m, K, D, kb=\"body\"):\n    a, b = K[K[kb] == \"bb\"][m].dropna(), K[K[kb] == \"rs\"][m].dropna(); sd = np.nanstd(pd.concat([a, b])); r = dict(billboard=round(float(a.mean()), 3), rolling_stone=round(float(b.mean()), 3))\n    for v in (\"v118\", \"v119\"):\n        e = D[D.ver == v]; ps = [e[e.song == s][m].mean() for s in SG]; da, db = (e[m].mean() - a.mean()) / sd, (e[m].mean() - b.mean()) / sd; sides = {np.sign(x - a.mean()) for x in ps} | {np.sign(x - b.mean()) for x in ps}\n        r[v] = round(float(e[m].mean()), 3); r[v + \"_by_song\"] = [round(float(x), 3) for x in ps]; r[v + \"_sd_from_each\"] = [round(float(da), 2), round(float(db), 2)]; r[v + \"_differs_from_both_in_every_song\"] = bool(min(abs(da), abs(db)) >= .25 and len(sides) == 1); r[v + \"_within_a_quarter_sd_of_both\"] = bool(max(abs(da), abs(db)) < .25)\n    return r\nfirst = lambda D: D[(D.k == \"1\") & D.sec.isin((\"verse\", \"chorus\"))]\nout[\"first verse and chorus: every measure\"] = {m: row(m, first(KA), first(A)) for m in FE + [\"range\", \"empty_bars\", \"notes_per_bar\"] if m in A}\nout[\"the melody over chord and bass\"] = {m: row(m, KO, O) for m in (\"downbeat_chord_tone\", \"downbeat_on_root\", \"downbeat_on_third\", \"downbeat_on_fifth\", \"melody_on_root\", \"melody_on_third\", \"melody_on_fifth\", \"melody_a_step_above_a_chord_tone\", \"over_bass_second_or_seventh\", \"parallel_perfect\", \"contrary_of_moving\")}\nout[\"by section: chorus first beat on the third (billboard, rolling stone, v118, v119)\"] = [round(float(KO[(KO.body == b) & (KO.sec == \"chorus\")].downbeat_on_third.mean()), 3) for b in (\"bb\", \"rs\")] + [round(float(O[(O.ver == v) & (O.sec == \"chorus\")].downbeat_on_third.mean()), 3) for v in (\"v118\", \"v119\")]\n# the second verse beside the first\nv2 = {}\nfor v in (\"v118\", \"v119\"):\n    D = A[A.ver == v].assign(bid=lambda d: d.song + \"_\" + d.build.astype(str)); a, b = S(D, \"verse\", \"1\").set_index(\"bid\"), S(D, \"verse\", \"2\").set_index(\"bid\"); ix = a.index.intersection(b.index); dd = {}\n    for m in FE: dd[m] = round(float((b.loc[ix, m] - a.loc[ix, m]).mean() / np.nanstd(S(KA, \"verse\", \"1\")[m])), 2)\n    v2[v] = {\"pairs\": len(ix), \"measures under 0.15 sd, of %d\" % len(FE): int(sum(abs(x) < .15 for x in dd.values())), \"largest\": sorted(dd.items(), key=lambda kv: -abs(kv[1]))[:8], \"verse 1 / verse 2 / kept verse 2\": {m: [round(float(a[m].mean()), 3), round(float(b[m].mean()), 3), round(float(S(KA, \"verse\", \"2\")[m].mean()), 3)] for m in (\"chord_tones_on_beat\", \"chord_tones\", \"repeat\", \"step\", \"equal_gap_run_max\", \"gap_eighth\")}}\n    pk = []\n    for (vv, s, bi, sec, k), N in wins.items():\n        if vv == v and sec == \"verse\" and k == \"2\" and (vv, s, bi, \"verse\", \"1\") in wins: pk.append(pair(wins[(vv, s, bi, \"verse\", \"1\")], N))\n    pk = pd.DataFrame(pk); v2[v][\"verse 2 beside verse 1: bars the same rhythm, pitch kept\"] = [round(float(pk.bars_same_rhythm.mean()), 3), round(float(pk.pitch_kept.mean()), 3)]\nout[\"the second verse less the first, paired by build\"] = v2\nlin = lambda: make_pipeline(SimpleImputer(strategy=\"median\"), StandardScaler(), LogisticRegression(C=.3, max_iter=2000, class_weight=\"balanced\")); rng = np.random.default_rng(19)\ndef sep(Kd, Bd, feats, reps=8):\n    res = []\n    for _ in range(reps):\n        ps = Kd.piece.unique(); rng.shuffle(ps); h = set(ps[: len(ps) // 2]); ktr, kte = Kd[Kd.piece.isin(h)], Kd[~Kd.piece.isin(h)]\n        for s in SG:\n            tr, te = Bd[Bd.song != s], Bd[Bd.song == s]\n            if len(te) < 30: continue\n            tr = tr.sample(min(len(tr), 3 * len(ktr)), random_state=int(rng.integers(1e6))); te = te.sample(min(len(te), 3 * len(kte)), random_state=int(rng.integers(1e6)))\n            m = lin(); m.fit(pd.concat([ktr[feats], tr[feats]]).astype(float), np.r_[np.ones(len(ktr)), np.zeros(len(tr))]); res.append(roc_auc_score(np.r_[np.ones(len(kte)), np.zeros(len(te))], m.predict_proba(pd.concat([kte[feats], te[feats]]).astype(float))[:, 1]))\n    return [round(float(np.mean(res)), 3), round(float(np.std(res)), 3)]\nNOH = [m for m in FE if m not in HARM]\nout[\"separation by section, five songs (one held out in turn), both collections pooled\"] = {v: {f\"{s} {k}\": {\"agreed measures and chord tones\": sep(S(KA, s, k), S(A[A.ver == v], s, k), FE), \"without the chord tones\": sep(S(KA, s, k), S(A[A.ver == v], s, k), NOH), \"chord tones alone\": sep(S(KA, s, k), S(A[A.ver == v], s, k), HARM), \"the six of 426 alone\": sep(S(KA, s, k), S(A[A.ver == v], s, k), SIX)} for s, k in ((\"verse\", \"1\"), (\"verse\", \"2\"), (\"chorus\", \"1\"), (\"bridge\", \"1\"))} for v in (\"v118\", \"v119\")}\njson.dump(out, open(\"reread_findings.json\", \"w\"), indent=1, default=str); print(\"done\")\n"
}