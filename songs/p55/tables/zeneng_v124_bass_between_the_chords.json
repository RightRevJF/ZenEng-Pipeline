 },
 "code": "\"\"\"The bass between the chords, from records: the Lucerne Groove Library. Predictions in PREDICTION.md. Run: python3 -I lucerne_study.py\"\"\"\nimport json, re, pickle, collections, warnings, numpy as np, pandas as pd\nwarnings.filterwarnings(\"ignore\")\nE_ = pd.read_csv(\"/home/claude/corpus/lucerne/events.csv\"); S = pd.read_csv(\"/home/claude/corpus/lucerne/stimuli.csv\")\nPCN = {\"C\": 0, \"D\": 2, \"E\": 4, \"F\": 5, \"G\": 7, \"A\": 9, \"B\": 11, \"H\": 11}\ndef pitch(n):\n    m = re.match(r\"^([A-H])([#b]?)(-?\\d)$\", str(n))\n    return None if not m else 12 * (int(m.group(3)) + 1) + PCN[m.group(1)] + (m.group(2) == \"#\") - (m.group(2) == \"b\")\ndef measures(B, K, nbars=8):\n    \"\"\"B: bass (position in beats, duration in beats, pitch), sorted; K: kick positions. Eight bars of four beats.\"\"\"\n    if len(B) < 8: return None\n    t = np.array([b[0] for b in B]); du = np.array([b[1] for b in B]); p = np.array([b[2] for b in B]); f = {}; q = lambda x: int(round(x * 12))\n    T = np.array([q(x) for x in t]); KK = sorted({q(x) for x in K}); fr = T % 12; beat = (T // 12) % 4\n    f[\"notes_per_bar\"] = len(B) / nbars; f[\"on_beat\"] = (fr == 0).mean(); f[\"on_offbeat_eighth\"] = (fr == 6).mean(); f[\"on_sixteenth\"] = np.isin(fr, (3, 9)).mean(); f[\"on_triplet\"] = np.isin(fr, (4, 8)).mean()\n    bars = collections.defaultdict(list)\n    for x, d, y in zip(T, du, p): bars[int(x // 48)].append((int(x % 48), int(y), float(d)))\n    f[\"bars_with_a_note_on_beat1\"] = np.mean([any(o == 0 for o, _, _ in bars.get(b, [])) for b in range(nbars)]); f[\"empty_bars\"] = np.mean([b not in bars for b in range(nbars)])\n    f[\"pitch_classes_per_bar\"] = np.mean([len({y % 12 for _, y, _ in v}) for v in bars.values()]); f[\"bars_one_pitch_class\"] = np.mean([len({y % 12 for _, y, _ in v}) == 1 for v in bars.values()]); f[\"distinct_pitch_classes\"] = len(set(p % 12)); f[\"range\"] = p.max() - p.min(); f[\"median_pitch\"] = float(np.median(p))\n    first = {b: v[0][1] % 12 for b, v in bars.items() if v[0][0] == 0}                       # the bar's first-beat note as its stand-in root\n    rel = [(y - first[b]) % 12 for b, v in bars.items() if b in first for _, y, _ in v]\n    if len(rel) >= 8: f[\"on_the_bars_first_note\"] = np.mean([r == 0 for r in rel]); f[\"a_fifth_from_it\"] = np.mean([r == 7 for r in rel]); f[\"a_third_from_it\"] = np.mean([r in (3, 4) for r in rel]); f[\"a_seventh_from_it\"] = np.mean([r in (10, 11) for r in rel]); f[\"another_note\"] = np.mean([r in (1, 2, 5, 6, 8, 9) for r in rel])\n    iv = np.abs(np.diff(p)); f[\"iv_repeat\"] = (iv == 0).mean(); f[\"iv_step\"] = np.isin(iv, (1, 2)).mean(); f[\"iv_semitone\"] = (iv == 1).mean(); f[\"iv_third\"] = np.isin(iv, (3, 4)).mean(); f[\"iv_fourth_fifth\"] = np.isin(iv, (5, 7)).mean(); f[\"iv_octave\"] = (iv == 12).mean(); f[\"iv_other\"] = (~np.isin(iv, (0, 1, 2, 3, 4, 5, 7, 12))).mean()\n    rh = {b: tuple(o for o, _, _ in v) for b, v in bars.items()}; fg = {b: tuple((o, y - v[0][1]) for o, y, _ in v) for b, v in bars.items()}\n    f[\"bar_rhythm_same_as_last\"] = np.mean([rh.get(b) == rh.get(b - 1) for b in range(1, nbars) if b in rh]); f[\"bar_rhythm_same_as_two_back\"] = np.mean([rh.get(b) == rh.get(b - 2) for b in range(2, nbars) if b in rh]); f[\"bar_figure_same_as_last\"] = np.mean([fg.get(b) == fg.get(b - 1) for b in range(1, nbars) if b in fg]); f[\"bar_figure_same_as_two_back\"] = np.mean([fg.get(b) == fg.get(b - 2) for b in range(2, nbars) if b in fg])\n    f[\"distinct_bar_rhythms\"] = len(set(rh.values())); f[\"top_bar_rhythm_share\"] = max(collections.Counter(rh.values()).values()) / len(rh)\n    f[\"last_bar_differs_from_the_first_seven\"] = float(rh.get(nbars - 1) not in [rh.get(b) for b in range(nbars - 1)]) if nbars - 1 in rh else np.nan; f[\"bar_4_or_8_has_more_notes\"] = float(np.mean([len(bars.get(b, [])) for b in (3, 7)]) > np.mean([len(bars.get(b, [])) for b in (0, 1, 2, 4, 5, 6)]))\n    gap = np.diff(T) / 12; f[\"sounding_share_of_gap\"] = float(np.mean(np.minimum(1, du[:-1] / np.maximum(gap, 1e-6)))) ; f[\"short_notes\"] = float(np.mean(du[:-1] / np.maximum(gap, 1e-6) <= 0.5)); f[\"sounding_share\"] = min(1.0, du.sum() / (4 * nbars))\n    if KK:\n        ks = set(KK); bs = set(T.tolist()); f[\"kick_with_bass\"] = np.mean([k in bs for k in KK]); f[\"bass_with_kick\"] = np.mean([x in ks for x in T]); f[\"kicks_per_bar\"] = len(KK) / nbars\n        b1 = [b * 48 for b in range(nbars)]; f[\"beat1_kick_and_bass\"] = np.mean([(x in ks) and (x in bs) for x in b1]); f[\"bass_between_kicks_off_the_beat\"] = np.mean([(x not in ks) and (x % 12 != 0) for x in T])\n    ap = collections.Counter()\n    for b in range(nbars - 1):\n        if b in bars and b + 1 in bars and bars[b + 1][0][0] == 0 and len(bars[b]) >= 2:\n            d = abs(bars[b][-1][1] - bars[b + 1][0][1]); ap[\"same\" if d == 0 else \"semitone\" if d == 1 else \"whole_step\" if d == 2 else \"third\" if d in (3, 4) else \"fourth_or_fifth\" if d in (5, 7) else \"octave\" if d == 12 else \"other\"] += 1\n    n = sum(ap.values())\n    if n >= 4:\n        for k in (\"same\", \"semitone\", \"whole_step\", \"third\", \"fourth_or_fifth\", \"octave\", \"other\"): f[\"into_the_bar_\" + k] = ap[k] / n\n        ch = n - ap[\"same\"]; f[\"into_the_bar_by_step_of_changes\"] = (ap[\"semitone\"] + ap[\"whole_step\"]) / ch if ch >= 3 else np.nan\n    return {k: float(v) for k, v in f.items()}, ap\nif __name__ == \"__main__\":\n    rows = []; AP = collections.Counter()\n    for sg, g in E_.groupby(\"siglum\", sort=False):\n        g = g[g.position < 32]; B = sorted((float(r.position), float(r.duration) / 100, pitch(r.name)) for r in g.itertuples() if pitch(r.name) is not None and float(r.duration) > 0); K = [float(r.position) for r in g.itertuples() if r.name == \"BD\"]\n        mono = []\n        for b in B:\n            if mono and abs(mono[-1][0] - b[0]) < 1e-6:\n                if b[2] < mono[-1][2]: mono[-1] = b\n                continue\n            mono.append(b)\n        m = measures(mono, K)\n        if m: rows.append(dict(m[0], siglum=sg)); AP.update(m[1])\n    L = pd.DataFrame(rows).merge(S[[\"Stimulus\", \"Title\", \"Band\", \"Year\", \"Style\", \"Tempo\", \"MOV\", \"PLE\", \"Swing8\", \"Swing16\"]], left_on=\"siglum\", right_on=\"Stimulus\", how=\"left\"); L.to_pickle(\"lucerne_measures.pkl\")\n    MS = [c for c in rows[0] if c != \"siglum\"]; MS = [m for m in L.columns if m in set().union(*[set(r) for r in rows]) and m != \"siglum\"]\n    Q = lambda D, m: [round(float(D[m].quantile(x)), 3) for x in (.05, .25, .5, .75, .95)]\n    out = {\"patterns\": len(L), \"bass notes\": int(sum(r[\"notes_per_bar\"] * 8 for r in rows)), \"by style\": L.Style.value_counts().to_dict(), \"years\": [int(L.Year.min()), int(L.Year.median()), int(L.Year.max())], \"percentiles (5, 25, 50, 75, 95)\": {m: Q(L, m) for m in MS}, \"mean\": {m: round(float(L[m].mean()), 3) for m in MS}}\n    tot = sum(AP.values()); out[\"the last note of a bar into the first of the next, pooled\"] = {k: round(v / tot, 3) for k, v in AP.most_common()} | {\"pairs\": tot}\n    # the engine's cells\n    NAME = {\"C\": 0, \"D\": 2, \"E\": 4, \"F\": 5, \"G\": 7, \"A\": 9, \"B\": 11}\n    def rt(c, lo): r = NAME[c[0]] + (1 if \"#\" in c[:2] else -1 if (len(c) > 1 and c[1] == \"b\") else 0); return lo + (r - lo) % 12\n    def approach(a, b, scale):\n        if a == b: return a + 7\n        for d in (-2, 2, -1, 1):\n            if (b + d) % 12 in scale: return b + d if abs(b + d - a) <= 7 else (b + d - 12 if b + d - 12 >= 33 else b + d)\n        return b - 5 if b - 5 >= 33 else b + 7\n    eng = {}\n    for s, ton in ((\"40\", 2), (\"43\", 0), (\"44\", 3)):\n        P = pickle.load(open(f\"/home/claude/p50/melody_v118_p{s}_main.pkl\", \"rb\")); st = {}; i = 0\n        for name, kind, nb in P[\"form\"]: st[name] = (i, nb); i += nb\n        scale = {(ton + x) % 12 for x in (0, 2, 4, 5, 7, 9, 11)}\n        for sec in (\"Verse 1\", \"Chorus 1\"):\n            b0 = st[sec][0]; ch = P[\"chords\"][b0:b0 + 9]; B = []; K = []\n            for k in range(8):\n                c, nx = ch[k], ch[min(k + 1, len(ch) - 1)]\n                if s == \"40\":\n                    r = rt(c, 36); a = approach(r, rt(nx, 36), scale)\n                    if sec == \"Verse 1\": B += [(4 * k + e / 12, d / 12, x) for e, d, x in ((0, 17, r), (18, 5, r), (24, 17, r), (42, 5, a))]; K += [4 * k, 4 * k + 2]\n                    else: B += [(4 * k + j / 2, 5 / 12, x) for j, x in enumerate([r, r, r + 7, r, r, r + 12, r + 7, a])]; K += [4 * k, 4 * k + 2, 4 * k + 2.5]\n                else:\n                    r = rt(c, 33 if s == \"43\" else 34)\n                    if s == \"44\" and sec == \"Verse 1\": B += [(4 * k + j, 10 / 12, r) for j in range(4)]\n                    else: B += [(4 * k + j / 2, 5 / 12, r + 12 if j % 2 else r) for j in range(8)]\n                    K += [4 * k + j for j in range(4)]\n            eng[f\"song {s}, {sec.split()[0].lower()}\"] = measures(B, K)[0]\n    pct = lambda m, v: round(float((L[m].dropna() <= v).mean()), 2)\n    out[\"the engine's cells: value and its place among the 444 patterns (share at or below)\"] = {k: {m: [round(v[m], 3), pct(m, v[m])] for m in (\"notes_per_bar\", \"pitch_classes_per_bar\", \"bars_one_pitch_class\", \"on_the_bars_first_note\", \"iv_repeat\", \"iv_octave\", \"iv_step\", \"bar_rhythm_same_as_last\", \"bar_figure_same_as_last\", \"distinct_bar_rhythms\", \"kick_with_bass\", \"bass_with_kick\", \"on_beat\", \"on_sixteenth\", \"sounding_share_of_gap\", \"last_bar_differs_from_the_first_seven\") if m in v} for k, v in eng.items()}\n    # the sequenced copies of Window 118 beside the transcriptions\n    LK = json.load(open(\"/home/claude/zeneng/corpus/bass_figures/lakh_bass_findings.json\"))[\"percentiles (5, 25, 50, 75, 95)\"]\n    mp = {\"notes_per_bar\": \"notes_per_bar\", \"on_beat\": \"on_beat\", \"on_offbeat_eighth\": \"on_offbeat_eighth\", \"on_sixteenth\": \"on_sixteenth\", \"bars_with_a_note_on_beat1\": \"bars_with_a_note_on_beat1\", \"bars_one_pitch_class\": \"bars_one_pitch\", \"iv_repeat\": \"iv_repeat\", \"iv_step\": \"iv_step\", \"iv_third\": \"iv_third\", \"iv_fourth_fifth\": \"iv_fourth_fifth\", \"iv_octave\": \"iv_octave\", \"bar_rhythm_same_as_last\": \"bar_rhythm_same_as_last\", \"bar_rhythm_same_as_two_back\": \"bar_rhythm_same_as_two_back\", \"bar_figure_same_as_last\": \"bar_figure_same_as_last\", \"top_bar_rhythm_share\": \"top_bar_rhythm_share\", \"range\": \"range\", \"median_pitch\": \"median_pitch\", \"kick_with_bass\": \"kick_with_bass\", \"bass_with_kick\": \"bass_with_kick\"}\n    cmp_ = {}\n    for a, b in mp.items():\n        if b not in LK: continue\n        x, y = Q(L, a), LK[b]; cmp_[a] = {\"transcriptions (25, 50, 75)\": x[1:4], \"sequenced copies (25, 50, 75)\": y[1:4], \"each median inside the other's middle half\": bool(y[1] <= x[2] <= y[3] and x[1] <= y[2] <= x[3])}\n    out[\"4. transcriptions beside sequenced copies\"] = cmp_; out[\"4. agreeing\"] = [sum(v[\"each median inside the other's middle half\"] for v in cmp_.values()), len(cmp_)]\n    # by style, and against the ratings\n    out[\"by style (median)\"] = {st_: {m: round(float(g[m].median()), 3) for m in (\"notes_per_bar\", \"pitch_classes_per_bar\", \"on_the_bars_first_note\", \"iv_repeat\", \"iv_step\", \"bar_rhythm_same_as_last\", \"kick_with_bass\", \"bass_with_kick\", \"on_sixteenth\", \"sounding_share_of_gap\")} | {\"patterns\": len(g)} for st_, g in L.groupby(\"Style\")}\n    out[\"by years (median)\"] = {k: {m: round(float(g[m].median()), 3) for m in (\"notes_per_bar\", \"pitch_classes_per_bar\", \"on_the_bars_first_note\", \"iv_repeat\", \"bar_rhythm_same_as_last\", \"kick_with_bass\", \"on_sixteenth\")} | {\"patterns\": len(g)} for k, g in ((\"1956-1969\", L[L.Year < 1970]), (\"1970-1979\", L[(L.Year >= 1970) & (L.Year < 1980)]), (\"1980-1991\", L[(L.Year >= 1980) & (L.Year < 1992)]), (\"1992-2017\", L[L.Year >= 1992]))}\n    cr = {m: round(float(L[[m, \"MOV\"]].dropna().corr(method=\"spearman\").iloc[0, 1]), 3) for m in MS}; out[\"6. rank correlation with the urge to move\"] = dict(sorted(cr.items(), key=lambda kv: -abs(kv[1])))\n    json.dump(out, open(\"lucerne_findings.json\", \"w\"), indent=1); print(json.dumps(out, indent=1))\n"
}