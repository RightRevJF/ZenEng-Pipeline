 "code: cand(N) reads a window's notes (t in beats from the window's first barline, length, pitch)": "def cand(N):\n    \"\"\"N: (t in beats from the window's first barline, dur, pitch, ...), sorted. Onsets and pitches only.\"\"\"\n    t = np.array([n[0] for n in N], float); p = np.array([n[2] for n in N]); g = np.round(np.diff(t) * 12).astype(int); g = g[g > 0]; f = {}\n    if len(g) < 8: return None\n    # the even stream\n    runs = []; r = 1\n    for a, b in zip(g, g[1:]):\n        if a == b: r += 1\n        else: runs.append(r); r = 1\n    runs.append(r); f[\"equal_gap_run_max\"] = max(runs); f[\"gap_same_as_before\"] = float((g[1:] == g[:-1]).mean()); pr = np.array([c / len(g) for c in collections.Counter(g).values()]); f[\"gap_entropy\"] = float(-(pr * np.log2(pr)).sum())\n    f[\"gap_changes_per_bar\"] = float((g[1:] != g[:-1]).sum() / 8)\n    # repeated pitch\n    rp = []; r = 1\n    for a, b in zip(p, p[1:]):\n        if a == b: r += 1\n        else: rp.append(r); r = 1\n    rp.append(r); f[\"same_pitch_run_max\"] = max(rp); f[\"notes_in_runs_of_4\"] = float(sum(x for x in rp if x >= 4) / len(p))\n    # the burst\n    tt = np.round(t * 12).astype(int); f[\"most_onsets_in_a_beat\"] = max(int(((tt >= s) & (tt < s + 12)).sum()) for s in range(0, 32 * 12, 3)); f[\"most_onsets_in_a_bar\"] = max(int(((tt >= s) & (tt < s + 48)).sum()) for s in range(0, 32 * 12, 48))\n    f[\"longest_gap_beats\"] = float(g.max() / 12); f[\"fullest_bar_over_mean\"] = f[\"most_onsets_in_a_bar\"] / (len(t) / 8)\n    # phrases: onsets parted by a beat and a half or more\n    cut = [0] + [i + 1 for i, x in enumerate(np.diff(tt)) if x >= 18] + [len(tt)]; ph = [(tt[a], b - a, tt[b - 1] - tt[a]) for a, b in zip(cut, cut[1:])]\n    f[\"phrases\"] = len(ph); f[\"phrase_notes_median\"] = float(np.median([x[1] for x in ph])); f[\"phrase_notes_sd\"] = float(np.std([x[1] for x in ph])); st = [x[0] % 48 for x in ph]\n    f[\"phrase_starts_same_place\"] = float(max(collections.Counter(st).values()) / len(st)); f[\"phrase_span_share\"] = float(sum(x[2] for x in ph) / (32 * 12))\n    # the line's turning: up-down-up or down-up-down in three moves\n    mv = np.sign(np.diff(p)); mv = mv[mv != 0]; f[\"zigzag_of_three\"] = float(np.mean([(a != b) and (b != c) for a, b, c in zip(mv, mv[1:], mv[2:])])) if len(mv) >= 3 else np.nan\n    return f\n",
